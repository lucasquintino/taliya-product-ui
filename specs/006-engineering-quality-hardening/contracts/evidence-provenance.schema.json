{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taliya.dev/schemas/evidence-provenance.schema.json",
  "title": "Taliya Evidence Provenance",
  "description": "Revision-bound provenance for a canonical gate artifact. Absolute paths, Windows separators, traversal, secrets, and unfingerprinted decision inputs are forbidden.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactId",
    "kind",
    "relativePath",
    "sha256",
    "producer",
    "source",
    "inputFingerprints",
    "tool",
    "environment",
    "generatedAt",
    "freshness",
    "decision",
    "waiverIds",
    "normalized",
    "containsSecrets",
    "sensitivity"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.1.0"
    },
    "artifactId": {
      "type": "string",
      "format": "uuid"
    },
    "kind": {
      "enum": [
        "governance-report",
        "architecture-report",
        "typecheck-report",
        "lint-report",
        "unit-test-report",
        "coverage-report",
        "browser-test-report",
        "e2e-report",
        "accessibility-report",
        "visual-report",
        "security-report",
        "performance-report",
        "package-manifest",
        "consumer-validation-report",
        "sbom",
        "attestation",
        "release-decision"
      ]
    },
    "relativePath": {
      "$ref": "#/$defs/repositoryRelativePath"
    },
    "sha256": {
      "$ref": "#/$defs/sha256"
    },
    "producer": {
      "$ref": "#/$defs/producer"
    },
    "source": {
      "$ref": "#/$defs/sourceIdentity"
    },
    "inputFingerprints": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-zA-Z0-9._-]{1,127}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/sha256"
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "environment": {
      "$ref": "#/$defs/environment"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "freshness": {
      "$ref": "#/$defs/freshness"
    },
    "decision": {
      "enum": [
        "pass",
        "fail",
        "informative",
        "risk-accepted"
      ]
    },
    "waiverIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^WVR-[0-9]{4}-[0-9]{3,}$"
      }
    },
    "normalized": {
      "const": true
    },
    "containsSecrets": {
      "const": false
    },
    "sensitivity": {
      "enum": [
        "public",
        "internal",
        "confidential"
      ]
    },
    "redactions": {
      "type": "integer",
      "minimum": 0
    },
    "signature": {
      "$ref": "#/$defs/signature"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "risk-accepted"
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "properties": {
          "waiverIds": {
            "minItems": 1
          }
        }
      },
      "else": {
        "properties": {
          "waiverIds": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "$defs": {
    "gateId": {
      "enum": [
        "GATE-SDD-APPROVED",
        "G-GOV",
        "G-TYPE",
        "G-LINT",
        "G-UNIT",
        "G-COV",
        "G-ARCH",
        "G-TOKENS",
        "G-STORY-BUILD",
        "G-STORY-TEST",
        "G-A11Y",
        "G-E2E-PR",
        "G-E2E-RELEASE",
        "G-VISUAL",
        "G-SEC-RUNTIME",
        "G-SEC-TOOLCHAIN",
        "G-SEC-SAST",
        "G-SEC-SECRETS",
        "G-PERF",
        "G-PACK",
        "G-CONSUMER",
        "G-PROVENANCE",
        "G-RELEASE"
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "repositoryRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)[.][.](?:/|$))(?!.*//)[A-Za-z0-9._@-]+(?:/[A-Za-z0-9._@-]+)*$"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gateRunId",
        "gateId"
      ],
      "properties": {
        "gateRunId": {
          "type": "string",
          "format": "uuid"
        },
        "gateId": {
          "$ref": "#/$defs/gateId"
        }
      }
    },
    "sourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commitSha",
        "sourceTreeHash",
        "dirty"
      ],
      "properties": {
        "commitSha": {
          "$ref": "#/$defs/gitSha"
        },
        "sourceTreeHash": {
          "$ref": "#/$defs/sha256"
        },
        "dirty": {
          "type": "boolean"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operatingSystem",
        "architecture",
        "nodeVersion",
        "timezone"
      ],
      "properties": {
        "operatingSystem": {
          "enum": [
            "windows",
            "linux",
            "macos"
          ]
        },
        "architecture": {
          "enum": [
            "x64",
            "arm64"
          ]
        },
        "nodeVersion": {
          "type": "string",
          "minLength": 1
        },
        "browser": {
          "enum": [
            "chromium",
            "firefox",
            "webkit"
          ]
        },
        "browserVersion": {
          "type": "string",
          "minLength": 1
        },
        "timezone": {
          "const": "UTC"
        }
      },
      "dependentRequired": {
        "browser": [
          "browserVersion"
        ],
        "browserVersion": [
          "browser"
        ]
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policyId",
        "maxAgeHours",
        "validUntil"
      ],
      "properties": {
        "policyId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,63}$"
        },
        "maxAgeHours": {
          "type": "integer",
          "minimum": 1
        },
        "validUntil": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "enum": [
            "sigstore",
            "sha256-hmac",
            "other"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 16
        }
      }
    }
  },
  "examples": [
    {
      "schemaVersion": "1.1.0",
      "artifactId": "04910716-cf11-422e-bbd4-e1dcb1b934d1",
      "kind": "architecture-report",
      "relativePath": "artifacts/quality/architecture-report.json",
      "sha256": "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd",
      "producer": {
        "gateRunId": "0bf24249-38e7-4495-bcd5-87dac51ac8e6",
        "gateId": "G-ARCH"
      },
      "source": {
        "commitSha": "743cc5baf94f39d910f53cfd7c0876785ae83041",
        "sourceTreeHash": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "dirty": false
      },
      "inputFingerprints": {
        "source": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "policy": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
      },
      "tool": {
        "name": "architecture-audit",
        "version": "1.0.0"
      },
      "environment": {
        "operatingSystem": "windows",
        "architecture": "x64",
        "nodeVersion": "22.12.0",
        "timezone": "UTC"
      },
      "generatedAt": "2026-08-08T12:00:03Z",
      "freshness": {
        "policyId": "release-evidence-24h",
        "maxAgeHours": 24,
        "validUntil": "2026-08-09T12:00:03Z"
      },
      "decision": "pass",
      "waiverIds": [],
      "normalized": true,
      "containsSecrets": false,
      "sensitivity": "internal",
      "redactions": 0
    }
  ]
}
